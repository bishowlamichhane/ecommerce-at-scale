PORT=5000
PRODUCT_SERVICE_URL=http://localhost:5001
CART_SERVICE_URL=http://localhost:5002
ORDERS_SERVICE_URL=http://localhost:5003
SEARCH_SERVICE_URL=http://localhost:5004

# Rate limiting (project 1, phase 2)
# gcra | fixed-window (the baseline it's measured against) | off
RATE_LIMIT_ALGORITHM=gcra
# open: keep serving, unlimited, if Redis is down | closed: answer 503
RATE_LIMIT_FAIL_MODE=open
REDIS_HOST=localhost
REDIS_PORT=6379
# Proxies allowed to set X-Forwarded-For. Leave empty unless something sits in
# front of the gateway; never "true". Load tests that simulate many client IPs
# from this machine start the gateway with TRUST_PROXY=loopback.
TRUST_PROXY=
