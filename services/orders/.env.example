PORT=5003
DATABASE_URL=postgres://store:store@localhost:5433/orders_service
CART_SERVICE_URL=http://localhost:5002
PRODUCT_SERVICE_URL=http://localhost:5001
REDIS_HOST=localhost
REDIS_PORT=6379
# Bull Board, the job queue UI: http://localhost:5003/admin/queues
BULL_BOARD=true
# The sweeper (jobs/reconcile.js): how often it runs, how long an order may
# stay Pending, and how long a reservation may stay open without an order.
RECONCILE_EVERY_MS=30000
PENDING_GRACE_MS=60000
STALE_RESERVATION_MS=120000
